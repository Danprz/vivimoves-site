---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExternalLink from '../components/ExternalLink.astro';
import ContactBand from '../components/ContactBand.astro';
import GoogleReview from '../components/GoogleReview.astro';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/a-propos-studio-tapis.webp';
import portrait from '../assets/virginia-studio.jpg';
import photoParticuliers from '../assets/a-propos-particuliers-salle.jpg';
import photoEntreprises from '../assets/a-propos-entreprises-atelier.jpg';
import { reviewFor } from '../data/reviews';
import { SITE_TITLE, VIRGINIA_LINKEDIN_URL } from '../consts';

const univers = [
	{
		titre: 'Pour les particuliers',
		texte:
			'Des cours de Pilates, des sorties running, des ateliers et des mini-retraites pour bouger, se retrouver et vivre des expériences qui font du bien.',
		photo: photoParticuliers,
		alt: 'Cours collectif dans une grande salle : une vingtaine de personnes à genoux sur leur tapis.',
		position: '50% 50%',
		href: '/le-pr-club/',
		lien: 'Voir les cours et sorties',
	},
	{
		titre: 'Pour les entreprises',
		texte:
			'Des interventions sur mesure pour remettre le mouvement au cœur du quotidien professionnel, renforcer les liens et offrir aux équipes des moments de respiration.',
		photo: photoEntreprises,
		alt: 'Atelier en entreprise : une dizaine de personnes assises dans une salle claire suivent une projection.',
		position: '50% 60%',
		href: '/entreprises/',
		lien: 'Découvrir le bien-être au travail',
	},
];
---

<BaseLayout
	title={`À propos · ${SITE_TITLE}`}
	description="Bliss, un univers dédié au mouvement, au bien-être et aux rencontres, à Cergy et dans le Val-d’Oise : pour les particuliers et pour les entreprises."
>
	<section class="hero propos-hero on-dark">
		<Image
			src={heroPhoto}
			alt=""
			widths={[640, 960, 1472]}
			sizes="100vw"
			class="hero-photo"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="hero-veil" aria-hidden="true"></div>
		<div class="wrap hero-content">
			<div class="hero-text">
				<h1>Bliss, des expériences qui font du bien</h1>
				<p class="lede mt-6">
					Bliss, c’est un univers dédié au mouvement, au bien-être et aux rencontres.
				</p>
				<p class="mt-4 max-w-xl">
					Né de l’envie de partager bien plus qu’une pratique sportive, Bliss imagine des moments
					pour bouger, découvrir, se retrouver et prendre du temps pour soi.
				</p>
				<p class="mt-4 max-w-xl">
					Des expériences pensées pour s’intégrer dans le quotidien, créer du lien et cultiver le
					plaisir de prendre soin de soi, ensemble.
				</p>
			</div>
		</div>
	</section>

	<section>
		<div class="wrap section conviction">
			<h2>Notre conviction</h2>
			<div>
				<p class="lede">
					Nous croyons que le mouvement mérite une place dans nos vies, sans pression ni
					recherche de performance.
				</p>
				<p class="mt-5 measure">
					Bouger, ralentir, découvrir, partager : autant de façons de cultiver son bien-être au
					quotidien, dans la simplicité et la convivialité.
				</p>
			</div>
		</div>
	</section>

	<section class="bg-sunk" aria-labelledby="univers-titre">
		<div class="wrap section">
			<h2 id="univers-titre">Deux univers, une même philosophie</h2>
			<div class="univers mt-10">
				{
					univers.map((u) => (
						<article class="univers-item">
							<Image
								src={u.photo}
								alt={u.alt}
								widths={[384, 576, 768]}
								sizes="(min-width: 48rem) 30rem, 100vw"
								class="univers-photo"
								style={`object-position: ${u.position}`}
								loading="lazy"
							/>
							<h3 class="mt-6">{u.titre}</h3>
							<p class="mt-3">{u.texte}</p>
							<p class="mt-4">
								<a class="text-link" href={u.href}>
									{u.lien}
								</a>
							</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section>
		<div class="wrap section grid gap-10 md:grid-cols-[18rem_1fr] md:items-start md:gap-16">
			<Image
				src={portrait}
				alt="Virginia, souriante, debout à l’entrée d’un studio de Pilates, en t-shirt du PR Club."
				widths={[320, 480, 640]}
				sizes="(min-width: 48rem) 18rem, 60vw"
				class="portrait aspect-[3/4] w-full max-w-72 rounded-lg object-cover object-top"
				loading="lazy"
			/>
			<div>
				<h2>Derrière Bliss, Virginia</h2>
				<p class="lede mt-5 measure">
					Ancienne ingénieure, j’ai choisi de me reconvertir pour faire de ma passion pour le
					mouvement mon métier et partager ses nombreux bienfaits sur le corps et l’esprit.
				</p>
				<p class="mt-4 measure">
					Aujourd’hui coach sportive diplômée d’État, j’enseigne le Pilates sur tapis et sur
					reformer. Curieuse et animée par l’envie d’enrichir ma pratique, je suis également
					partie en Inde, à Rishikesh, pour me former au yoga traditionnel et à l’Ayurveda, la
					médecine traditionnelle indienne.
				</p>
				<p class="mt-4 measure">
					À travers Bliss, je réunis mes expériences et mes inspirations pour proposer une
					approche du bien-être plus globale, accessible et humaine, où le mouvement, la
					découverte et le partage occupent une place essentielle.
				</p>
				<p class="mt-5">
					<ExternalLink class="text-link" href={VIRGINIA_LINKEDIN_URL}>
						Voir mon profil LinkedIn
					</ExternalLink>
				</p>
			</div>
		</div>
	</section>

	<GoogleReview review={reviewFor('a-propos')} tone="sunk" />

	<ContactBand />
</BaseLayout>

<style>
	.propos-hero :global(.hero-photo) {
		object-position: 55% 40%;
	}
	.propos-hero .hero-content {
		grid-template-rows: 1fr;
	}
	.propos-hero h1 {
		max-width: 16ch;
	}
	.conviction {
		display: grid;
		gap: 1rem;
	}
	.univers {
		display: grid;
		gap: 3rem;
	}
	.univers-item h3 {
		font-size: 1.5rem;
	}
	:global(.univers-photo) {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		border-radius: 0.5rem;
		border: 2px solid var(--color-ink);
	}
	/* Même atténuation que la photo des sorties running. */
	:global(.portrait) {
		filter: saturate(0.7) brightness(0.92);
	}
	@media (min-width: 48rem) {
		.conviction {
			grid-template-columns: 1fr 1.3fr;
			gap: 4rem;
		}
		.univers {
			grid-template-columns: 1fr 1fr;
			gap: 4rem;
		}
	}
</style>
