---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExternalLink from '../components/ExternalLink.astro';
import ContactBand from '../components/ContactBand.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/virginia-portrait.jpg';
import { VIRGINIA_LINKEDIN_URL } from '../consts';
---

<BaseLayout
	title="À propos · Vivimoves"
	description="Vivimoves, entreprise locale à taille humaine : des propositions bien-être pour les salariés de Cergy et du Val-d’Oise."
>
	<section class="wrap pt-12 pb-14 md:pt-20 md:pb-20">
		<h1 class="max-w-4xl">Vivimoves, le bien-être au travail près de chez vous</h1>
	</section>

	<section class="border-t border-line">
		<div class="wrap ruled">
			<div class="block-row !border-t-0">
				<h2>Une proposition locale</h2>
				<p class="lede">
					Vivimoves s’adresse aux entreprises de Cergy et du Val-d’Oise et à leurs salariés.
					Nous intervenons près de chez vous.
				</p>
			</div>
			<div class="block-row">
				<h2>Une entreprise à taille humaine</h2>
				<p class="lede">
					Ici, pas de plateforme ni de catalogue impersonnel : vous échangez avec la même
					personne du premier contact à la séance, et chaque proposition est construite pour
					votre équipe.
				</p>
			</div>
			<div class="block-row">
				<h2>Notre conviction</h2>
				<p class="lede">
					Le mouvement mérite une place centrale dans la vie personnelle comme dans la vie
					professionnelle. Nous partageons des outils simples pour prendre soin de soi
					durablement.
				</p>
			</div>
		</div>
	</section>

	<section class="bg-sunk">
		<div class="wrap section grid gap-10 md:grid-cols-[18rem_1fr] md:items-start md:gap-16">
			<Image
				src={portrait}
				alt="Portrait de Virginia, assise sur un tapis de pratique."
				widths={[320, 480, 640]}
				sizes="(min-width: 48rem) 18rem, 60vw"
				class="aspect-square w-full max-w-72 rounded-lg object-cover object-top"
				loading="lazy"
			/>
			<div>
				<h2>Qui intervient ?</h2>
				<p class="mt-5 text-xl font-bold">Virginia, fondatrice et intervenante</p>
				<p class="mt-3 measure">
					Ancienne ingénieure PMO chez SAVENCIA, Virginia connaît de l’intérieur les journées
					qui s’enchaînent entre deux réunions. Coach sportive certifiée, diplômée d’État, elle
					enseigne le Pilates sur tapis et sur reformer et s’est formée à l’enseignement du
					yoga en Inde, à Rishikesh Yogpeeth.
				</p>
				<p class="mt-4">
					<ExternalLink class="text-link" href={VIRGINIA_LINKEDIN_URL}>
						Voir son profil LinkedIn
					</ExternalLink>
				</p>
			</div>
		</div>
	</section>

	<ContactBand />
</BaseLayout>

<style>
	.block-row {
		display: grid;
		gap: 1rem;
		padding-block: clamp(2.5rem, 6vw, 4rem);
	}
	@media (min-width: 48rem) {
		.block-row {
			grid-template-columns: 1fr 1.3fr;
			gap: 4rem;
		}
	}
</style>
