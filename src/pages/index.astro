---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import AboutBand from '../components/AboutBand.astro';
import ContactBand from '../components/ContactBand.astro';
import { Image } from 'astro:assets';
import clubPhoto from '../assets/club-plein-air.jpg';
import { activities } from '../data/activities';
import { SITE_DESCRIPTION } from '../consts';
---

<BaseLayout title="Vivimoves · Mouvement et bien-être en entreprise" description={SITE_DESCRIPTION}>
	<section class="wrap grid gap-10 pt-12 pb-16 md:grid-cols-[1.25fr_1fr] md:items-stretch md:gap-14 md:pt-20 md:pb-24">
		<div class="flex flex-col justify-center">
			<h1>Le mouvement a toute sa place au travail.</h1>
			<p class="lede mt-6">
				Vivimoves propose aux entreprises du Val-d’Oise des cours, des ateliers et des
				mini-retraites d’équipe, pour que vos salariés puissent bouger, respirer et faire une
				vraie pause.
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
				<Cta href="/contact/">Parlons de votre équipe</Cta>
				<Cta href="/entreprises/" variant="link">Découvrir les interventions</Cta>
			</div>
		</div>
		<div class="on-accent hero-panel" aria-hidden="true">
			<span class="sun"></span>
			<p>Cergy · Val-d’Oise (95)</p>
		</div>
	</section>

	<section class="border-t border-line">
		<div class="wrap section grid gap-10 md:grid-cols-[1fr_1.4fr] md:gap-16">
			<div>
				<h2>Cinq façons de remettre du mouvement dans la journée</h2>
				<p class="mt-5 text-ink-soft">
					En cours réguliers, en ateliers ponctuels ou en mini-retraite d’équipe.
				</p>
				<p class="mt-4">
					<Cta href="/entreprises/" variant="link">Voir les interventions en entreprise</Cta>
				</p>
			</div>
			<ul class="ruled border-b border-line-strong">
				{
					activities.map((activity) => (
						<li class="grid gap-1 py-5 sm:grid-cols-[14rem_1fr] sm:gap-6">
							<a class="font-bold" href={`/entreprises/#${activity.slug}`}>
								{activity.shortTitle}
							</a>
							<span class="text-ink-soft">{activity.teaser}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="on-accent bg-action">
		<div class="wrap section grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
			<Image
				src={clubPhoto}
				alt="Séance de Pilates du PR Club en plein air : quatre personnes assises sur des tapis dans l’herbe."
				widths={[480, 768, 1024]}
				sizes="(min-width: 48rem) 34rem, 100vw"
				class="aspect-[4/3] w-full rounded-lg border-2 border-ink object-cover"
				loading="lazy"
			/>
			<div>
				<h2>Le PR Club</h2>
				<p class="lede mt-5">
					Envie de courir ou de pratiquer le Pilates en groupe ? Le PR Club réunit celles et
					ceux qui aiment bouger ensemble dans le Val-d’Oise.
				</p>
				<p class="mt-6">
					<Cta href="/le-pr-club/" variant="secondary">Découvrir Le PR Club</Cta>
				</p>
			</div>
		</div>
	</section>

	<AboutBand />
	<ContactBand />
</BaseLayout>

<style>
	.hero-panel {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2rem;
		min-height: 14rem;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		background: var(--color-action);
		border: 2px solid var(--color-ink);
		border-radius: 0.75rem;
		font-weight: 700;
	}
	.sun {
		width: clamp(7rem, 22vw, 13rem);
		aspect-ratio: 1;
		background: var(--color-ink);
		-webkit-mask: url('/soleil.svg') center / contain no-repeat;
		mask: url('/soleil.svg') center / contain no-repeat;
	}
</style>
