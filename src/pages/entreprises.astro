---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import ActivityItem from '../components/ActivityItem.astro';
import AboutBand from '../components/AboutBand.astro';
import ContactBand from '../components/ContactBand.astro';
import { activities } from '../data/activities';
import { formats } from '../data/formats';
import { ZONE_SENTENCE } from '../consts';

const steps = [
	{
		title: 'On échange',
		text: 'Vous nous parlez de votre équipe, de votre contexte et de vos envies.',
	},
	{
		title: 'Nous vous proposons une intervention adaptée',
		text: 'Pratique, format et rythme : la proposition se construit à partir de ce que vous nous avez décrit.',
	},
	{
		title: 'On passe à la pratique',
		text: 'La séance, l’atelier ou la mini-retraite a lieu avec votre équipe.',
	},
];
---

<BaseLayout
	title="Yoga, Pilates et bien-être en entreprise · Vivimoves"
	description="Cinq pratiques pour vos équipes à Cergy et dans le Val-d’Oise : cours réguliers, ateliers ponctuels ou mini-retraites d’équipe. Parlons de votre projet."
>
	<section class="wrap pt-12 pb-16 md:pt-20 md:pb-24">
		<h1 class="max-w-4xl">Des pauses qui remettent vos équipes en mouvement</h1>
		<p class="lede mt-6">
			Yoga, Pilates, éveil musculaire, gym posturale, méditation et bains sonores : nous
			intervenons auprès de vos salariés, en cours réguliers, en ateliers ou en mini-retraite.
		</p>
		<div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
			<Cta href="/contact/">Parlons de votre équipe</Cta>
			<Cta href="#activites" variant="link">Voir les cinq pratiques</Cta>
		</div>
	</section>

	<section class="bg-sunk">
		<div class="wrap section grid gap-6 md:grid-cols-2 md:gap-16">
			<h2>Pourquoi bouger pendant la journée de travail ?</h2>
			<p class="lede">
				Entre deux réunions, le corps passe vite au second plan : on reste assis, on enchaîne,
				on oublie de respirer. Proposer un temps de mouvement ou de pause, c’est offrir à
				l’équipe un moment pour se délier, souffler et se retrouver autrement que devant un
				écran.
			</p>
		</div>
	</section>

	<section id="activites" class="wrap section">
		<h2 class="max-w-3xl">Cinq pratiques, cinq expériences différentes</h2>
		<div class="ruled mt-10 border-b border-line-strong">
			{activities.map((activity) => <ActivityItem activity={activity} />)}
		</div>
	</section>

	<section id="formats" class="on-accent bg-action">
		<div class="wrap section">
			<h2 class="max-w-3xl">Trois formats pour s’adapter à votre rythme</h2>
			<ul class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
				{
					formats.map((format) => (
						<li class="border-t-2 border-ink pt-5">
							<h3>{format.title}</h3>
							<p class="mt-3">{format.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section id="demarche" class="wrap section">
		<h2 class="max-w-3xl">Comment se construit un projet</h2>
		<ol class="steps mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
			{
				steps.map((step) => (
					<li>
						<h3>{step.title}</h3>
						<p class="mt-3 text-ink-soft">{step.text}</p>
					</li>
				))
			}
		</ol>
		<p class="mt-12 max-w-2xl border-t border-line-strong pt-6">
			<strong>{ZONE_SENTENCE}</strong> Votre entreprise est ailleurs ? <a href="/contact/">Parlons-en</a>.
		</p>
	</section>

	<AboutBand showFacilitator />
	<ContactBand
		title="Parlons de votre équipe"
		text="Décrivez-nous votre contexte, même en quelques lignes. On construit le reste ensemble."
	/>
</BaseLayout>

<style>
	.steps {
		list-style: none;
		padding: 0;
		counter-reset: step;
	}
	.steps li {
		counter-increment: step;
	}
	.steps li::before {
		content: counter(step);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		margin-bottom: 1rem;
		border: 2px solid var(--color-ink);
		border-radius: 999px;
		background: var(--color-action);
		font-weight: 700;
	}
</style>
