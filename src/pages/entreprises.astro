---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import ContactBand from '../components/ContactBand.astro';
import KeyFigures from '../components/KeyFigures.astro';
import PracticeTile from '../components/PracticeTile.astro';
import AtelierBlock from '../components/AtelierBlock.astro';
import GoogleReview from '../components/GoogleReview.astro';
import { activities } from '../data/activities';
import { ateliers } from '../data/ateliers';
import { reviewFor } from '../data/reviews';
import { SITE_TITLE, ZONE_SENTENCE } from '../consts';

// Un exemple adaptable : ni horaires, ni lieu, ni nombre de participants.
const retreatSteps = [
	{ title: 'Accueil et mise en mouvement', text: 'Un réveil du corps en douceur, pour arriver.' },
	{ title: 'Pratique guidée', text: 'Yoga ou Pilates, accessible à tous les niveaux.' },
	{ title: 'Atelier à thème', text: 'Mouvement, alimentation ou sommeil : l’équipe choisit.' },
	{ title: 'Bain sonore de clôture', text: 'Un temps calme pour repartir posé.' },
];
---

<BaseLayout
	title={`Bien-être en entreprise : cours, ateliers et mini-retraites · ${SITE_TITLE}`}
	description="Cours réguliers de yoga, Pilates, running ou gym posturale, ateliers bien-être et mini-retraites d’équipe à Cergy et dans le Val-d’Oise."
>
	<section class="wrap pt-12 pb-16 md:pt-20 md:pb-24">
		<h1 class="max-w-4xl">Des pauses qui remettent vos équipes en mouvement</h1>
		<p class="lede mt-6">
			Entre deux réunions, le corps passe vite au second plan. Nous proposons à vos salariés des
			cours réguliers, des ateliers et des mini-retraites pour bouger, souffler et se retrouver
			autrement que devant un écran.
		</p>
		<div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
			<Cta href="/contact/">Parlons de votre équipe</Cta>
			<Cta href="#cours-reguliers" variant="link">Voir les trois formats</Cta>
		</div>
		<p class="mt-5 text-ink-soft">
			{ZONE_SENTENCE} Votre entreprise est ailleurs&nbsp;? <a href="/contact/">Parlons-en</a>.
		</p>

		<h2 class="mt-14 text-[clamp(1.25rem,1.12rem+0.6vw,1.5rem)] md:mt-20">
			Pourquoi bouger pendant la journée de travail&nbsp;?
		</h2>
		<KeyFigures />
	</section>

	<section id="cours-reguliers" class="border-t border-line">
		<div class="wrap section">
			<div class="grid gap-5 md:grid-cols-[1fr_1.4fr] md:items-end md:gap-16">
				<h2>Cours réguliers</h2>
				<p class="lede">
					Un rendez-vous récurrent pour installer une pratique dans l’équipe. Cinq pratiques, à
					choisir ensemble&nbsp;:
				</p>
			</div>
			<ul class="mt-10 grid gap-x-6 gap-y-10 md:grid-cols-6">
				{
					activities.map((activity, index) => (
						<PracticeTile activity={activity} size={index < 2 ? 'large' : 'small'} />
					))
				}
			</ul>
			<p class="mt-6 text-[0.9375rem] text-ink-soft">Images d’illustration.</p>
			<p class="mt-12">
				<Cta href="/contact/#contact-form">Mettre en place un cours régulier</Cta>
			</p>
		</div>
	</section>

	<section id="ateliers" class="bg-sunk">
		<div class="wrap section">
			<div class="grid gap-5 md:grid-cols-[1fr_1.4fr] md:items-end md:gap-16">
				<h2>Ateliers ponctuels de bien-être et de prévention</h2>
				<p class="lede">
					Un temps fort autour d’un thème, pour comprendre et repartir avec des repères simples.
					Trois ateliers au choix&nbsp;:
				</p>
			</div>
			<div class="mt-12 grid gap-12 lg:grid-cols-3 lg:gap-x-10 lg:gap-y-0">
				{ateliers.map((atelier) => <AtelierBlock atelier={atelier} />)}
			</div>
			<p class="mt-8 text-[0.9375rem] text-ink-soft">Images d’illustration.</p>
		</div>
	</section>

	<section id="mini-retraites" class="on-accent bg-action">
		<div class="wrap section grid gap-10 md:grid-cols-[1fr_1.2fr] md:gap-16">
			<div>
				<h2>Mini-retraites d’équipe</h2>
				<p class="lede mt-5">
					Une journée ou une demi-journée pour ralentir, bouger et se retrouver, loin des écrans.
				</p>
				<p class="mt-4 measure">
					Le programme se construit avec vous&nbsp;: les pratiques et le rythme s’adaptent à votre
					équipe.
				</p>
				<p class="mt-6">
					<Cta href="/contact/?activite=mini-retraite#contact-form" variant="secondary">
						Imaginer une mini-retraite
					</Cta>
				</p>
			</div>
			<div>
				<h3>Un exemple de déroulé</h3>
				<ol class="steps steps-inline mt-6 grid gap-6">
					{
						retreatSteps.map((step) => (
							<li>
								<div>
									<h4 class="font-bold">{step.title}</h4>
									<p class="mt-1">{step.text}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</section>

	<GoogleReview review={reviewFor('entreprises')} intro="Ce que disent les participants à nos cours" />
	<ContactBand
		title="Parlons de votre équipe"
		text="Décrivez-nous votre contexte, même en quelques lignes. On construit le reste ensemble."
	/>
</BaseLayout>
