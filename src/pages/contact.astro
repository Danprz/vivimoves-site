---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import ExternalLink from '../components/ExternalLink.astro';
import {
	SITE_TITLE,
	CONTACT_EMAIL,
	BOOKWHEN_URL,
	VIRGINIA_INSTAGRAM_URL,
	VIRGINIA_LINKEDIN_URL,
	ZONE_SENTENCE,
} from '../consts';
---

<BaseLayout
	title={`Contact · Parlons de votre équipe · ${SITE_TITLE}`}
	description="Un projet de cours, d’atelier ou de mini-retraite pour votre équipe ? Écrivez-nous pour en parler."
>
	<section class="wrap contact-grid pt-12 pb-20 md:pt-20 md:pb-28">
		<div class="contact-intro">
			<h1>Parlons de votre équipe</h1>
			<p class="lede mt-6">
				Quelques lignes sur votre contexte suffisent pour commencer. Nous revenons vers vous
				pour en discuter.
			</p>
			<p class="mt-6 text-ink-soft">
				{ZONE_SENTENCE} Votre entreprise est ailleurs ? Parlons-en.
			</p>

		</div>

		<div class="contact-form-cell"><ContactForm /></div>

		<div class="contact-aside">
			<div class="border-t border-line-strong pt-6">
				<h2 class="text-xl tracking-normal">Votre interlocutrice</h2>
				<p class="mt-2">Virginia, fondatrice de Bliss, coach sportive diplômée d’État.</p>
				<ul class="mt-2">
					<li><a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>Écrire un e-mail</a></li>
					<li><ExternalLink class="text-link" href={VIRGINIA_LINKEDIN_URL}>LinkedIn</ExternalLink></li>
					<li><ExternalLink class="text-link" href={VIRGINIA_INSTAGRAM_URL}>Instagram</ExternalLink></li>
				</ul>
			</div>

			<div class="mt-8 border-t border-line-strong pt-6">
				<h2 class="text-xl tracking-normal">Une séance du PR Club ?</h2>
				<p class="mt-2">
					Vous souhaitez réserver une séance du PR Club ? Les réservations se font sur Bookwhen.
				</p>
				<p class="mt-2">
					<ExternalLink class="text-link" href={BOOKWHEN_URL}>Voir les prochaines séances</ExternalLink>
				</p>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.contact-grid {
		display: grid;
		gap: 2.5rem;
	}
	@media (min-width: 48rem) {
		.contact-grid {
			grid-template-columns: 1fr 1.25fr;
			grid-template-areas:
				'intro form'
				'aside form';
			grid-template-rows: auto 1fr;
			column-gap: 4rem;
		}
		.contact-intro {
			grid-area: intro;
		}
		.contact-form-cell {
			grid-area: form;
		}
		.contact-aside {
			grid-area: aside;
		}
	}
</style>
