---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

// Gabarit conservé pour un futur contenu éditorial ; aucune route ne l'utilise aujourd'hui.
type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<article class="wrap section">
		{heroImage && <img class="mb-10 w-full rounded-lg object-cover" src={heroImage} alt="" width="1920" height="960" />}
		<div class="measure mx-auto">
			<p class="text-ink-soft">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span>
							{' · '}Mis à jour le <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
			<h1 class="mt-3">{title}</h1>
			<div class="mt-8 grid gap-5">
				<slot />
			</div>
		</div>
	</article>
</BaseLayout>
