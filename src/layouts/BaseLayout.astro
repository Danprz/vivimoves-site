---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	/** « club » donne plus de place au moutarde sur la page du PR Club. */
	tone?: 'entreprise' | 'club';
}

const { title, description, image, tone = 'entreprise' } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body class="antialiased" data-tone={tone}>
		<a class="skip-link" href="#contenu">Aller au contenu</a>
		<Header />
		<main id="contenu" tabindex="-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main:focus {
		outline: none;
	}
</style>
