---
import ExternalLink from './ExternalLink.astro';
import {
	SITE_TITLE,
	CONTACT_EMAIL,
	PR_CLUB_INSTAGRAM_URL,
	VIRGINIA_INSTAGRAM_URL,
	VIRGINIA_LINKEDIN_URL,
	ZONE_SENTENCE,
} from '../consts';

const year = new Date().getFullYear();
---

<footer class="on-dark bg-ink text-page">
	<div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
		<div>
			<p class="text-xl font-bold">{SITE_TITLE}</p>
			<p class="mt-3 max-w-sm text-on-dark-soft">
				Bien-être et mouvement en entreprise. {ZONE_SENTENCE}
			</p>
		</div>
		<nav aria-label="Pied de page">
			<h2 class="text-base tracking-normal">Le site</h2>
			<ul class="mt-2">
				<li><a class="foot-link" href="/entreprises/">Bien-être au travail</a></li>
				<li><a class="foot-link" href="/le-pr-club/">Pilates &amp; running</a></li>
				<li><a class="foot-link" href="/a-propos/">À propos</a></li>
				<li><a class="foot-link" href="/contact/">Contact</a></li>
			</ul>
		</nav>
		<div>
			<h2 class="text-base tracking-normal">Nous joindre</h2>
			<ul class="mt-2">
				<li><a class="foot-link" href={`mailto:${CONTACT_EMAIL}`}>Écrire un e-mail</a></li>
				<li><ExternalLink class="foot-link" href={VIRGINIA_LINKEDIN_URL}>LinkedIn</ExternalLink></li>
				<li><ExternalLink class="foot-link" href={VIRGINIA_INSTAGRAM_URL}>Instagram</ExternalLink></li>
				<li><ExternalLink class="foot-link" href={PR_CLUB_INSTAGRAM_URL}>Instagram du PR Club</ExternalLink></li>
			</ul>
		</div>
	</div>
	<div class="wrap flex flex-wrap justify-between gap-x-6 gap-y-1 border-t border-ink-soft py-5 text-[0.9375rem] text-on-dark-soft">
		<p>© {year} {SITE_TITLE}</p>
		<p>Site réalisé par Daniprz</p>
	</div>
</footer>

<style>
	.foot-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 2.75rem;
		text-decoration: underline;
		text-decoration-color: transparent;
		transition: text-decoration-color 0.18s var(--ease-out-expo);
	}
	.foot-link:hover {
		text-decoration-color: var(--color-action);
	}
</style>
