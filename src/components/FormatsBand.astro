---
import { Image } from 'astro:assets';
import { formats } from '../data/formats';
---

<section class="on-accent bg-action">
	<div class="wrap section">
		<h2 class="max-w-3xl">Trois formats pour s’adapter à votre rythme</h2>
		<ul class="formats mt-10 grid gap-10 md:grid-cols-3 md:gap-x-10 md:gap-y-0">
			{
				formats.map((format) => (
					<li class="format">
						<Image
							src={format.image}
							alt={format.alt}
							widths={[384, 576, 768]}
							sizes="(min-width: 48rem) 22rem, 100vw"
							class="aspect-[4/3] w-full rounded-lg object-cover"
							loading="lazy"
						/>
						<h3 class="mt-5">
							<a class="format-link" href={`/entreprises/#${format.slug}`}>
								{format.title}
							</a>
						</h3>
						<p class="mt-3">{format.text}</p>
						<p class="format-more" aria-hidden="true">
							En savoir plus
							<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M5 12h14M13 6l6 6-6 6" />
							</svg>
						</p>
					</li>
				))
			}
		</ul>
		<p class="mt-8 text-[0.9375rem]">Images d’illustration.</p>
	</div>
</section>

<style>
	.format {
		position: relative;
		display: flex;
		flex-direction: column;
		padding-top: 1.25rem;
		padding-bottom: 0.25rem;
		border-top: 2px solid var(--color-ink);
	}
	/* Lignes partagées : photo, titre, texte et lien démarrent à la même hauteur dans les trois colonnes. */
	@supports (grid-template-rows: subgrid) {
		@media (min-width: 48rem) {
			.format {
				display: grid;
				grid-row: span 4;
				grid-template-rows: subgrid;
			}
		}
	}
	.format-link {
		text-decoration: none;
	}
	/* Le lien couvre toute la colonne : une seule tabulation, une grande zone cliquable. */
	.format-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.format-link:focus-visible {
		outline: none;
	}
	.format:has(.format-link:focus-visible) {
		outline: 2px solid var(--color-ink);
		outline-offset: 6px;
		border-radius: 0.25rem;
	}
	.format-more {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: auto;
		padding-top: 1rem;
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 0.1em;
		text-underline-offset: 0.25em;
		transition: text-decoration-thickness 0.18s var(--ease-out-expo);
	}
	.format:hover .format-link {
		text-decoration: underline;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.2em;
	}
	.format:hover .format-more {
		text-decoration-thickness: 0.16em;
	}
</style>
