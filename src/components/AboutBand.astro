---
import Cta from './Cta.astro';

interface Props {
	/** Sur la page Entreprises, précise qui anime les séances. */
	showFacilitator?: boolean;
}

const { showFacilitator = false } = Astro.props;
---

<section class="bg-sunk">
	<div class="wrap section grid gap-6 md:grid-cols-2 md:gap-16">
		<h2>Une entreprise locale, à taille humaine</h2>
		<div>
			<p class="lede">
				Vivimoves est basée à Cergy. Nous intervenons près de chez vous, avec une seule
				interlocutrice du premier échange jusqu’à la séance.
			</p>
			{
				showFacilitator && (
					<p class="mt-4 text-ink-soft">
						Les séances sont animées par Virginia, coach sportive diplômée d’État.
					</p>
				)
			}
			<p class="mt-4">
				<Cta href="/a-propos/" variant="link">Découvrir Vivimoves</Cta>
			</p>
		</div>
	</div>
</section>
