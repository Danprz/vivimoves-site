---
import ExternalLink from './ExternalLink.astro';
import { figures } from '../data/figures';
---

<ul
	class:list={[
		'mt-8 grid gap-8 md:gap-10',
		figures.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2',
	]}
>
	{
		figures.map((figure) => (
			<li class="border-t-2 border-ink pt-5">
				<p class="figure-value">{figure.value}</p>
				<p class="mt-2">{figure.text}</p>
				<p class="mt-3 text-[0.9375rem] text-ink-soft">
					<cite class="not-italic">
						Source&nbsp;: <ExternalLink href={figure.sourceUrl}>{figure.source}</ExternalLink>
					</cite>
				</p>
			</li>
		))
	}
</ul>

<style>
	.figure-value {
		font-size: clamp(2rem, 1.5rem + 2.2vw, 3rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.02em;
	}
</style>
