---
import Cta from './Cta.astro';
import type { Activity } from '../data/activities';

interface Props {
	activity: Activity;
}

const { activity } = Astro.props;
---

<article id={activity.slug} class="grid gap-6 py-10 md:grid-cols-[1fr_1.6fr] md:gap-16 md:py-14">
	<div>
		<h3 class="text-[clamp(1.5rem,1.2rem+1.2vw,2rem)]">{activity.title}</h3>
		<p class="mt-3 text-ink-soft">{activity.description}</p>
	</div>
	<div class="measure">
		<h4 class="font-bold">L’expérience</h4>
		<p class="mt-1">{activity.experience}</p>
		<h4 class="mt-6 font-bold">Pour quelles situations ?</h4>
		<ul class="mt-1 list-disc pl-5 marker:text-accent-text">
			{activity.situations.map((situation) => <li>{situation}</li>)}
		</ul>
		<p class="mt-5">
			<Cta href={`/contact/?activite=${activity.slug}#contact-form`} variant="link">
				{activity.ctaLabel}
			</Cta>
		</p>
	</div>
</article>
