---
import ExternalLink from './ExternalLink.astro';
import type { Review } from '../data/reviews';
import { GOOGLE_REVIEWS_URL } from '../consts';

interface Props {
	review: Review;
	/** Phrase d’introduction ; sur /entreprises/, elle précise qu’il s’agit de participants aux cours. */
	intro?: string;
	class?: string;
}

const { review, intro = 'Ils et elles en parlent', class: className } = Astro.props;
---

<div class:list={['max-w-2xl', className]}>
	<p class="font-bold">{intro}</p>
	<figure class="mt-3 border-t-2 border-ink pt-5">
		<blockquote>
			<p class="lede">«&nbsp;{review.text}&nbsp;»</p>
		</blockquote>
		<figcaption class="mt-3 text-ink-soft">{review.author} · Avis Google</figcaption>
	</figure>
	<p class="mt-1">
		<ExternalLink class="text-link" href={GOOGLE_REVIEWS_URL}>Lire tous les avis sur Google</ExternalLink>
	</p>
</div>
