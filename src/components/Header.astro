---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<div class="wrap bar">
		<a href="/" class="brand">
			<span class="mark" aria-hidden="true"></span>
			{SITE_TITLE}
		</a>
		<button type="button" class="menu-btn" aria-expanded="false" aria-controls="nav-principale">
			<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<path d="M4 7h16M4 12h16M4 17h16"></path>
			</svg>
			Menu
		</button>
		<nav id="nav-principale" aria-label="Navigation principale">
			<ul>
				<li><HeaderLink href="/entreprises/">Bien-être au travail</HeaderLink></li>
				<li><HeaderLink href="/le-pr-club/">Pilates &amp; running</HeaderLink></li>
				<li><HeaderLink href="/a-propos/">À propos</HeaderLink></li>
				<li><HeaderLink href="/contact/" class="nav-cta">Contact</HeaderLink></li>
			</ul>
		</nav>
	</div>
</header>

<script>
	const button = document.querySelector<HTMLButtonElement>('.menu-btn');
	const nav = document.getElementById('nav-principale');
	if (button && nav) {
		const setOpen = (open: boolean) => {
			button.setAttribute('aria-expanded', String(open));
			nav.toggleAttribute('data-open', open);
		};
		button.addEventListener('click', () => {
			setOpen(button.getAttribute('aria-expanded') !== 'true');
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
				setOpen(false);
				button.focus();
			}
		});
		window.matchMedia('(min-width: 48rem)').addEventListener('change', () => setOpen(false));
	}
</script>

<style>
	.site-header {
		background: var(--color-page);
		border-bottom: 1px solid var(--color-line);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-block: 0.75rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 2.75rem;
		font-weight: 700;
		font-size: 1.25rem;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.mark {
		width: 1.75rem;
		height: 1.75rem;
		background: var(--color-action);
		-webkit-mask: url('/soleil.svg') center / contain no-repeat;
		mask: url('/soleil.svg') center / contain no-repeat;
	}
	.menu-btn {
		display: none;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0.5rem 0.9rem;
		border: 2px solid var(--color-ink);
		border-radius: 0.5rem;
		background: transparent;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	.menu-btn[aria-expanded='true'] {
		background: var(--color-ink);
		color: var(--color-page);
	}
	nav ul {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	nav :global(a) {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0.5rem 0.75rem;
		border-radius: 0.5rem;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 0.18s var(--ease-out-expo);
	}
	nav :global(a:hover) {
		background: var(--color-sunk);
	}
	nav :global(a[aria-current='page']) {
		text-decoration: underline;
		text-decoration-thickness: 0.14em;
		text-underline-offset: 0.35em;
		text-decoration-color: var(--color-action-hover);
	}
	nav :global(a.nav-cta) {
		padding-inline: 1.1rem;
		border: 2px solid var(--color-ink);
		background: var(--color-action);
	}
	nav :global(a.nav-cta:hover) {
		background: var(--color-action-hover);
	}
	nav :global(a.nav-cta[aria-current='page']) {
		text-decoration-color: var(--color-ink);
	}

	@media (max-width: 47.99rem) {
		:global(.js) .menu-btn {
			display: inline-flex;
		}
		:global(.js) nav:not([data-open]) {
			display: none;
		}
		nav {
			width: 100%;
		}
		:global(.js) nav ul {
			flex-direction: column;
			align-items: stretch;
			gap: 0.25rem;
			padding-block: 0.5rem 0.75rem;
		}
		:global(.js) nav :global(a) {
			width: 100%;
			padding-block: 0.75rem;
		}
		:global(.js) nav :global(a.nav-cta) {
			justify-content: center;
			margin-top: 0.25rem;
		}
	}
</style>
